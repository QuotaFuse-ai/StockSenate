# StockSenate 环境变量模板
#
# 用法：cp .env.example .env 后填写带【必填】的项。
# 本程序启动时会自动读取当前工作目录下的 .env；进程环境里已有的变量优先，不会被覆盖。
# 若从其他目录启动，可显式导出：
#     bash        set -a; . /path/to/.env; set +a
# 容器部署由 docker/entrypoint.sh 与 docker-compose.yml 读取，无需手动导出。
#
# 标记约定
#   【必填】     不填则该功能无法使用
#   【选填】     留空使用代码默认值
#   【仅容器】   只在 Docker/compose 下生效；本机直接运行时请用命令行参数
#   【未实现】   当前版本不读取，填了不生效，仅为后续版本预留
#
# 本文件只放占位符：任何真实密钥都不得写入仓库。.env 已被 .gitignore 忽略。

# ---------- 模型凭据 ----------
# 密钥只从环境变量读取，不要写进 config/llm_config.toml。
# 优先级：STOCKSENATE_LLM_API_KEY > provider 专属变量。
#
# 【必填-至少一项】通用密钥，对 llm_config.toml 里的所有 provider 生效
STOCKSENATE_LLM_API_KEY=
# 【必填-按需其一】按 llm_provider 填对应变量；默认 provider 是 minimax
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=

# ---------- 配置与存储 ----------
# 【选填】配置目录。默认使用包内 config/，优先级：
#   STOCKSENATE_CONFIG_DIR > TRADINGAGENTS_CONFIG_DIR > QF_COUNCIL_CONFIG_DIR > ~/.stock_senate
# 命中旧前缀时会向 stderr 提示迁移。
STOCKSENATE_CONFIG_DIR=
# 【选填】数据、报告、缓存根目录，默认 ~/.stock_senate
STOCKSENATE_HOME=

# ---------- MCP Server ----------
# 【仅容器】端口由 docker/entrypoint.sh 传给 `ssenate mcp http --port`。
# 本机直接运行时请传参：ssenate mcp http --host 127.0.0.1 --port 8765
STOCKSENATE_MCP_PORT=8765
# 【必填-仅当对外监听】绑定非回环地址时必须设置，否则拒绝启动。
# 留空 = 只允许 127.0.0.1 访问。
# docker-compose 下容器固定绑定 0.0.0.0，因此这一项必须填，否则 mcp 拒绝启动。
STOCKSENATE_MCP_TOKEN=

# ---------- WebUI ----------
# 【仅容器】同上，本机请用 ssenate webui --port
STOCKSENATE_WEBUI_PORT=8788
# 【必填-仅当对外监听】WebUI 登录口令；留空 = 本机免登录模式。
# docker-compose 下容器固定绑定 0.0.0.0，因此这一项必须填，否则 webui 拒绝启动。
STOCKSENATE_WEBUI_PASSWORD=

# ---------- 告警 Webhook ----------
# 变量名由 config/alert_rules.toml 的 [channels.webhook].url_env / secret_env 指定，
# 要改名必须同时改那一处。webhook 通道默认关闭，启用前必须填这两项。
STOCKSENATE_ALERT_WEBHOOK=
STOCKSENATE_ALERT_WEBHOOK_SECRET=

# ---------- SQL Provider ----------
# 【选填】只读连接串，变量名由 config/data_source.toml 的 [providers.sql].dsn_env 指定。
# 留空则该 provider 自动跳过，不影响其他数据源。
STOCKSENATE_SQL_DSN=

# ---------- 当前版本不读取的变量（保留说明，避免误配） ----------
# STOCKSENATE_MCP_HOST / STOCKSENATE_WEBUI_HOST   宿主地址只能通过 --host 传参
# STOCKSENATE_LOG_LEVEL                          日志级别固定为 INFO
# STOCKSENATE_TRACE_EXPORTER / LANGFUSE_*        OTel/Langfuse 导出尚未接入（矩阵 9.6）
# STOCKSENATE_DATA_MODE / STOCKSENATE_PREFER_LOCAL_IMPORT
#                                                 由 config/data_source.toml 的 mode / prefer_local_import 控制
# NEWSIEVE_MCP_URL                               newsieve 已下线（DEC-009），新闻三域由 tickhub-cn 承担
# GOOGLE_API_KEY                                 本包不提供 google extra（DEC-007）
# TICKHUB_CN_MCP_URL                             provider 走 stdio 命令，不读 URL

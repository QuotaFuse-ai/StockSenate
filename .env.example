# StockSenate 运行配置示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，禁止提交真实密钥。

# --- 数据底座（TickHub / Newsieve）---
# data_source.toml 的 mode 覆盖：stockdata | local | hybrid | priority
STOCKSENATE_DATA_MODE=priority
TICKHUB_CN_MCP_URL=http://127.0.0.1:8000/mcp
TICKHUB_US_MCP_URL=http://127.0.0.1:8001/mcp
NEWSIEVE_MCP_URL=http://127.0.0.1:8002/mcp
# 允许在本地 import 时直接复用底座 SDK；跨进程部署请设为 false
STOCKSENATE_PREFER_LOCAL_IMPORT=true

# --- LLM ---
# 支持的值见 config/llm_config.toml；密钥优先从环境变量读取
STOCKSENATE_LLM_PROVIDER=minimax
MINIMAX_API_KEY=
# OpenAI 兼容后端可覆盖 base_url
STOCKSENATE_LLM_BACKEND_URL=
# 仅在使用 Google 时设置（与 mootdx 的 httpx 冲突见 DEC-007）
GOOGLE_API_KEY=

# --- MCP Server（端口 8765）---
STOCKSENATE_MCP_HOST=127.0.0.1
STOCKSENATE_MCP_PORT=8765
# 非本机访问必须设置；留空则仅允许 127.0.0.1
STOCKSENATE_MCP_TOKEN=

# --- WebUI（端口 8788）---
STOCKSENATE_WEBUI_HOST=127.0.0.1
STOCKSENATE_WEBUI_PORT=8788
STOCKSENATE_WEBUI_PASSWORD=

# --- 配置与存储 ---
# 默认 ~/.stock_senate，兼容旧前缀但新前缀优先（DEC-001）
STOCKSENATE_CONFIG_DIR=
STOCKSENATE_DATA_DIR=
STOCKSENATE_REPORT_DIR=
STOCKSENATE_CHECKPOINT_DIR=

# --- 告警 Webhook ---
STOCKSENATE_WEBHOOK_URL=
STOCKSENATE_WEBHOOK_SECRET=
# 秒；留空使用 alert_rules.toml 默认值
STOCKSENATE_WEBHOOK_TIMEOUT=

# --- 可观测性 ---
STOCKSENATE_LOG_LEVEL=INFO
STOCKSENATE_TRACE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000

# --- TickHub Admin（不属于本仓库，仅用于运维跳转）---
TICKHUB_ADMIN_URL=http://127.0.0.1:8787
